          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Event Time",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    srv.name AS \"Server\",\n    lqc.event_time AS \"Event Time\",\n    lqc.event_type AS \"Event Type\",\n    lqc.duration_microseconds / 1000.0 AS \"Duration\",\n    lqc.cpu_time_microseconds / 1000.0 AS \"CPU\",\n    lqc.logical_reads AS \"Logical Reads\",\n    lqc.physical_reads AS \"Physical Reads\",\n    lqc.writes AS \"Writes\",\n    lqc.row_count AS \"Rows\",\n    lqc.result AS \"Result\",\n    lqc.database_name AS \"Database\",\n    lqc.object_name AS \"Object\",\n    lqc.statement_text AS \"Statement\",\n    lqc.session_id AS \"Session\",\n    lqc.client_app_name AS \"Application\",\n    lqc.server_principal_name AS \"Login\",\n    lqc.query_hash AS \"Query Hash\"\nFROM collect.long_query_completions AS lqc\nJOIN config.config_monitored_servers AS srv ON srv.server_id = lqc.server_id\nWHERE $__timeFilter(lqc.collection_time)\n  AND lqc.server_id IN (${server:csv})\n  AND (cardinality(ARRAY[${database:sqlstring}]::text[]) = 0 OR lqc.database_name = ANY(ARRAY[${database:sqlstring}]::text[]))\nORDER BY lqc.event_time DESC\nLIMIT 200\n"
        }
      ],
      "description": "Attentions (cancels/timeouts) carry no duration - the event has none."
    }
  ]
