          ],
          "fields": ""
        },
        "sortBy": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    srv.name AS \"Server\",\n    CASE WHEN COALESCE(\n        (SELECT s.enabled FROM config.config_collector_schedules AS s\n         WHERE s.collector_name = 'long_query_completions'\n           AND s.server_id = srv.server_id),\n        (SELECT s.enabled FROM config.config_collector_schedules AS s\n         WHERE s.collector_name = 'long_query_completions'\n           AND s.server_id IS NULL),\n        false\n    ) THEN 'ON' ELSE 'OFF' END AS \"Trace Status\"\nFROM config.config_monitored_servers AS srv\nWHERE srv.is_enabled\n  AND srv.server_id IN (${server:csv})\nORDER BY srv.name\n"
        }
      ],
      "description": "Opt-in collector, defaults OFF. Enable it in the collector schedule config."
    },
    {
      "id": 2,
      "type": "table",
      "title": "Long-Running Query Completions",
      "datasource": {
        "type": "grafana-postgresql-datasource",
