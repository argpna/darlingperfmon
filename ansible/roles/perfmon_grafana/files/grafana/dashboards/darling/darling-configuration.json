            "uid": "darling"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    srv.name AS \"Server\",\n    tf.trace_flag AS \"Trace Flag\",\n    CASE WHEN tf.status THEN 'Enabled' ELSE 'Disabled' END AS \"Status\",\n    CASE WHEN tf.is_global THEN 'Yes' ELSE 'No' END AS \"Global\",\n    CASE WHEN tf.is_session THEN 'Yes' ELSE 'No' END AS \"Session\"\nFROM collect.v_trace_flags AS tf\nJOIN config.config_monitored_servers AS srv ON srv.server_id = tf.server_id\nWHERE tf.server_id IN (${server:csv})\n  AND tf.capture_time = (\n        SELECT MAX(inner_cap.capture_time) FROM collect.v_trace_flags AS inner_cap\n        WHERE inner_cap.server_id = tf.server_id\n    )\nORDER BY srv.name, tf.trace_flag\n"
