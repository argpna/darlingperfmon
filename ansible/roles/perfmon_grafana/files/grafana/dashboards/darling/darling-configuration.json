      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    srv.name AS \"Server\",\n    sc.configuration_name AS \"Setting\",\n    sc.value_configured AS \"Configured\",\n    sc.value_in_use AS \"In Use\",\n    CASE WHEN sc.is_dynamic THEN 'Yes' ELSE 'No' END AS \"Dynamic\",\n    CASE WHEN sc.is_advanced THEN 'Yes' ELSE 'No' END AS \"Advanced\",\n    /* ValuesMatch on the row class: a mismatch is a setting awaiting a restart. */\n    CASE WHEN sc.value_configured = sc.value_in_use THEN 'Yes' ELSE 'No' END AS \"Values Match\"\nFROM collect.v_server_config AS sc\nJOIN config.config_monitored_servers AS srv ON srv.server_id = sc.server_id\nWHERE sc.server_id IN (${server:csv})\n  AND sc.capture_time = (\n        SELECT MAX(inner_cap.capture_time) FROM collect.v_server_config AS inner_cap\n        WHERE inner_cap.server_id = sc.server_id\n    )\nORDER BY srv.name, sc.configuration_name\n"
        }
      ],
      "description": "Latest capture per server, not the dashboard time range."
    },
