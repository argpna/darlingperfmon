{
  "uid": "darling-waits",
  "title": "Waits",
  "tags": [
    "perfmon"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "weekStart": "",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Fleet Overview",
      "icon": "dashboard",
      "type": "link",
      "url": "/d/darling-fleet?${__url_time_range}",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "perfmon"
      ],
      "targetBlank": false,
      "title": "All PerfMon Dashboards",
      "type": "dashboards",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "darling"
        },
        "query": "SELECT name AS __text, server_id AS __value FROM config.config_monitored_servers WHERE is_enabled ORDER BY name",
        "current": {},
        "options": [],
        "refresh": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "description": "Monitored SQL Server instance, from Darling's fleet registry."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "row",
      "title": "Server Trends",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "panels": []
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Wait ms/sec",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "darling"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            }
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nWITH agg AS (\n    SELECT\n        ws.collection_time,\n        ws.server_name,\n        SUM(ws.delta_wait_time_ms) AS total_wait_ms\n    FROM collect.v_wait_stats AS ws\n    WHERE $__timeFilter(ws.collection_time)\n      AND ws.server_id IN (${server:csv})\n    GROUP BY ws.collection_time, ws.server_name\n),\ntimed AS (\n    SELECT\n        collection_time,\n        server_name,\n        total_wait_ms,\n        EXTRACT(EPOCH FROM (collection_time\n            - LAG(collection_time) OVER (PARTITION BY server_name\n                                         ORDER BY collection_time))) AS interval_seconds\n    FROM agg\n)\nSELECT\n    collection_time AS time,\n    server_name AS metric,\n    (total_wait_ms / interval_seconds)::numeric(18, 4) AS wait_ms_sec\nFROM timed\nWHERE interval_seconds > 0\nORDER BY 1\n"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Signal vs Resource Waits",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "darling"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nWITH agg AS (\n    SELECT\n        ws.collection_time,\n        SUM(ws.delta_signal_wait_time_ms) AS signal_ms,\n        SUM(ws.delta_wait_time_ms) - SUM(ws.delta_signal_wait_time_ms) AS resource_ms\n    FROM collect.v_wait_stats AS ws\n    WHERE $__timeFilter(ws.collection_time)\n      AND ws.server_id IN (${server:csv})\n    GROUP BY ws.collection_time\n)\nSELECT\n    collection_time AS time,\n    signal_ms AS \"Signal (CPU) ms\",\n    resource_ms AS \"Resource ms\"\nFROM agg\nORDER BY 1\n"
        }
      ]
    },
    {
      "id": 4,
      "type": "table",
      "title": "Top Waits",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "darling"
      },
      "gridPos": {
        "h": 10,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Wait Time (ms)",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    ws.server_name AS \"Server\",\n    ws.wait_type AS \"Wait Type\",\n    SUM(ws.delta_wait_time_ms) AS \"Wait Time (ms)\",\n    SUM(ws.delta_signal_wait_time_ms) AS \"Signal Wait (ms)\",\n    SUM(ws.delta_waiting_tasks) AS \"Waiting Tasks\",\n    CASE\n        WHEN SUM(ws.delta_waiting_tasks) > 0\n        THEN (SUM(ws.delta_wait_time_ms)::numeric\n              / SUM(ws.delta_waiting_tasks))::numeric(18, 2)\n    END AS \"Avg Wait (ms)\"\nFROM collect.v_wait_stats AS ws\nWHERE $__timeFilter(ws.collection_time)\n  AND ws.server_id IN (${server:csv})\nGROUP BY ws.server_name, ws.wait_type\nHAVING SUM(ws.delta_wait_time_ms) > 0\nORDER BY 3 DESC\nLIMIT 50\n"
        }
      ]
    }
  ]
}
