{
  "uid": "darling-tempdb",
  "title": "tempdb",
  "tags": [
    "perfmon"
  ],
  "timezone": "",
  "schemaVersion": 39,
  "editable": true,
  "graphTooltip": 1,
  "fiscalYearStartMonth": 0,
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "1m",
  "weekStart": "",
  "annotations": {
    "list": []
  },
  "links": [
    {
      "title": "Fleet Overview",
      "icon": "dashboard",
      "type": "link",
      "url": "/d/darling-fleet?${__url_time_range}",
      "keepTime": true,
      "includeVars": false,
      "targetBlank": false
    },
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "perfmon"
      ],
      "targetBlank": false,
      "title": "All PerfMon Dashboards",
      "type": "dashboards",
      "url": ""
    },
    {
      "asDropdown": true,
      "icon": "external link",
      "includeVars": true,
      "keepTime": true,
      "tags": [
        "finops"
      ],
      "targetBlank": false,
      "title": "All FinOps Dashboards",
      "type": "dashboards",
      "url": ""
    }
  ],
  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "darling"
        },
        "query": "SELECT name AS __text, server_id AS __value FROM config.config_monitored_servers WHERE is_enabled ORDER BY name",
        "current": {},
        "options": [],
        "refresh": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "description": "Monitored SQL Server instance, from Darling's fleet registry."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "tempdb Usage",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "darling"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "MB"
          },
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    td.collection_time AS time,\n    srv.name || ' - ' || s.series AS metric,\n    s.value AS value\nFROM collect.v_tempdb_stats AS td\nJOIN config.config_monitored_servers AS srv ON srv.server_id = td.server_id\nCROSS JOIN LATERAL (VALUES\n    ('User Objects', td.user_object_reserved_mb),\n    ('Internal Objects', td.internal_object_reserved_mb),\n    ('Version Store', td.version_store_reserved_mb)\n) AS s(series, value)\nWHERE $__timeFilter(td.collection_time)\n  AND td.server_id IN (${server:csv})\nORDER BY 1\n"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "tempdb Allocated Size",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "darling"
      },
      "gridPos": {
        "h": 7,
        "w": 24,
        "x": 0,
        "y": 9
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "Allocated MB"
          },
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    td.collection_time AS time,\n    srv.name AS metric,\n    td.total_reserved_mb + td.unallocated_mb AS value\nFROM collect.v_tempdb_stats AS td\nJOIN config.config_monitored_servers AS srv ON srv.server_id = td.server_id\nWHERE $__timeFilter(td.collection_time)\n  AND td.server_id IN (${server:csv})\nORDER BY 1\n"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "tempdb File I/O Latency",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "darling"
      },
      "gridPos": {
        "h": 9,
        "w": 24,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "palette-classic"
          },
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 1,
            "fillOpacity": 12,
            "showPoints": "never",
            "spanNulls": true,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisLabel": "tempdb File I/O Latency (ms)"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true,
          "calcs": []
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "time_series",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    f.collection_time AS time,\n    srv.name || ' - ' || f.file_name || s.suffix AS metric,\n    s.value AS value\nFROM collect.v_file_io_stats AS f\nJOIN config.config_monitored_servers AS srv ON srv.server_id = f.server_id\nCROSS JOIN LATERAL (VALUES\n    (' read', CASE WHEN f.delta_reads > 0\n                   THEN f.delta_stall_read_ms::double precision / f.delta_reads\n                   ELSE 0 END),\n    (' write', CASE WHEN f.delta_writes > 0\n                    THEN f.delta_stall_write_ms::double precision / f.delta_writes\n                    ELSE 0 END)\n) AS s(suffix, value)\nWHERE $__timeFilter(f.collection_time)\n  AND f.server_id IN (${server:csv})\n  AND f.database_name = 'tempdb'\nORDER BY 1\n"
        }
      ]
    }
  ]
}
