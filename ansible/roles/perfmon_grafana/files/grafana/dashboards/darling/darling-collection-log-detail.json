            "mode": "absolute",
            "steps": [
              {
                "color": "text",
                "value": null
              }
            ]
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "/^Total Runs$/",
          "values": false
        },
        "colorMode": "background",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "auto"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    COUNT(*) AS \"Total Runs\",\n    SUM(CASE WHEN cl.status = 'SUCCESS' THEN 1 ELSE 0 END) AS \"Success\",\n    SUM(CASE WHEN cl.status = 'ERROR' THEN 1 ELSE 0 END) AS \"Errors\",\n    AVG(cl.duration_ms) FILTER (WHERE cl.status = 'SUCCESS') AS \"Avg Duration\"\nFROM collect.v_collection_log AS cl\nWHERE \ncl.server_id IN (${server:csv})\n  AND (${collector_name:sqlstring} = '*' OR ${collector_name:sqlstring} = ''\n       OR cl.collector_name = ${collector_name:sqlstring})\n  AND cl.collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '168 hours'\n\n"
        }
      ]
    },
