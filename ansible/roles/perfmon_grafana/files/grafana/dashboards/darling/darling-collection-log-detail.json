      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Time",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT\n    cl.collection_time AS \"Time\",\n    cl.status AS \"Status\",\n    cl.rows_collected AS \"Rows\",\n    cl.duration_ms AS \"Duration\",\n    cl.sql_duration_ms AS \"SQL Duration\",\n    cl.duckdb_duration_ms AS \"Store Duration\",\n    cl.error_message AS \"Error\"\nFROM collect.v_collection_log AS cl\nWHERE \ncl.server_id IN (${server:csv})\n  AND (${collector_name:sqlstring} = '*' OR ${collector_name:sqlstring} = ''\n       OR cl.collector_name = ${collector_name:sqlstring})\n  AND cl.collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '168 hours'\n\nORDER BY cl.collection_time DESC\n"
        }
      ]
