  "templating": {
    "list": [
      {
        "name": "server",
        "label": "Server",
        "type": "query",
        "datasource": {
          "type": "grafana-postgresql-datasource",
          "uid": "darling"
        },
        "query": "SELECT name AS __text, server_id AS __value FROM config.config_monitored_servers WHERE is_enabled ORDER BY name",
        "current": {},
        "options": [],
        "refresh": 1,
        "hide": 0,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "description": "Monitored SQL Server instance, from Darling's fleet registry."
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "Msdb Access Status",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "darling"
      },
      "gridPos": {
        "h": 5,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "SUCCESS": {
                        "color": "green",
                        "index": 0
                      },
                      "PERMISSIONS": {
                        "color": "purple",
                        "index": 1
                      },
                      "ERROR": {
                        "color": "red",
                        "index": 2
                      },
                      "YIELDED": {
                        "color": "yellow",
                        "index": 3
                      },
                      "SKIPPED": {
                        "color": "text",
                        "index": 4
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nSELECT DISTINCT ON (cl.server_id)\n    srv.name AS \"Server\",\n    cl.status AS \"Status\"\nFROM collect.v_collection_log AS cl\nJOIN config.config_monitored_servers AS srv ON srv.server_id = cl.server_id\nWHERE cl.collector_name = 'running_jobs'\n  AND cl.server_id IN (${server:csv})\nORDER BY cl.server_id, cl.collection_time DESC\n"
        }
      ],
      "description": "PERMISSIONS means the login lacks msdb access."
    },
    {
      "id": 2,
      "type": "table",
      "title": "Currently Running SQL Agent Jobs",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "darling"
      },
      "gridPos": {
        "h": 13,
        "w": 24,
        "x": 0,
        "y": 5
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Running Long"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "Yes": {
                        "color": "red",
                        "index": 0
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Current Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Avg Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "P95 Duration"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "% of Average"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percent"
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "footer": {
          "show": false,
          "reducer": [
            "sum"
          ],
          "fields": ""
        },
        "sortBy": [
          {
            "displayName": "Current Duration",
            "desc": true
          }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "darling"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\nWITH latest AS (\n    SELECT\n        rj.server_id,\n        srv.name AS server_label,\n        MAX(rj.collection_time) AS mx\n    FROM collect.v_running_jobs AS rj\n    JOIN config.config_monitored_servers AS srv ON srv.server_id = rj.server_id\n    WHERE $__timeFilter(rj.collection_time)\n      AND rj.server_id IN (${server:csv})\n    GROUP BY rj.server_id, srv.name\n)\nSELECT\n    l.server_label AS \"Server\",\n    rj.job_name AS \"Job Name\",\n    rj.start_time AS \"Start Time\",\n    rj.current_duration_seconds AS \"Current Duration\",\n    rj.avg_duration_seconds AS \"Avg Duration\",\n    rj.p95_duration_seconds AS \"P95 Duration\",\n    rj.percent_of_average AS \"% of Average\",\n    CASE WHEN rj.is_running_long THEN 'Yes' ELSE '' END AS \"Running Long\",\n    rj.successful_run_count AS \"Successful Runs (30d)\"\nFROM latest AS l\nJOIN collect.v_running_jobs AS rj\n  ON rj.server_id = l.server_id\n AND rj.collection_time = l.mx\nORDER BY rj.current_duration_seconds DESC\n"
        }
      ]
    }
  ]
}
