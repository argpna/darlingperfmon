  # -----------------------------------------------------------------------
  # AG Sync Fell Behind
  # Upstream: AgAlertPolicy.JudgeSync / SyncFellBehindMetric
  # Fires when lag or redo queue crosses its threshold (0 disables a check; default: lag on
  # at 300s, redo queue off).
  # Source: PerformanceMonitor.Common/AgAlertPolicy.cs
  # Source table: collect.ag_database_replica_states
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - AG Sync Fell Behind"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-ag-sync-behind-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "AG Sync Fell Behind - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT COUNT(*) AS sync_behind_count
                FROM (
                    SELECT DISTINCT ON (ag_name, database_name, replica_server_name)
                        secondary_lag_seconds, redo_queue_size
                    FROM collect.ag_database_replica_states
                    WHERE server_id = {{ _sid }}
                      AND collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '1 hour'
                    ORDER BY ag_name, database_name, replica_server_name, collection_time DESC
                ) latest
                WHERE {{ _ag_sync_where }}
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            An Availability Group database reported by {{ item.inventory_hostname }} has
            fallen behind sync (lag >= {{ perfmon_alert_ag_lag_seconds }}s{% if perfmon_alert_ag_redo_queue_kb | int > 0 %} or redo queue >= {{ perfmon_alert_ag_redo_queue_kb }} KB{% endif %}).
