# Alert rules for {{ item.inventory_hostname }}
# Generated by Ansible perfmon_grafana role - do not edit directly.
# Source template: roles/perfmon_grafana/templates/alerting/rules-instance-darling.yaml.j2
#
# Ported from PerformanceMonitor.Darling.Service/DarlingAlertReadAdapter.cs (Darling's own
# alert-engine read layer for this schema). Blocking Detected, Long-Running Job/Failed Job, and
# Collection Stopped each have notable design choices - see each rule's own comment below for why.
# server_id is resolved by host, not display name (stable across a Viewer rename; see
# perfmon_darling/tasks/registry.yml for the same convention).
apiVersion: 1

groups:
{% set _server_host = (item.ds_host | default(item.ansible_host)) | replace("'", "''") %}
{% set _sid = "(SELECT server_id FROM config.config_monitored_servers WHERE host = '" ~ _server_host ~ "')" %}
{% set _ag_sync_conditions = [] %}
{% if perfmon_alert_ag_lag_seconds | int > 0 %}{% set _ = _ag_sync_conditions.append("(latest.secondary_lag_seconds >= " ~ (perfmon_alert_ag_lag_seconds | int) ~ ")") %}{% endif %}
{% if perfmon_alert_ag_redo_queue_kb | int > 0 %}{% set _ = _ag_sync_conditions.append("(latest.redo_queue_size >= " ~ (perfmon_alert_ag_redo_queue_kb | int) ~ ")") %}{% endif %}
{% set _ag_sync_where = _ag_sync_conditions | join(' OR ') if _ag_sync_conditions else 'FALSE' %}
  # -----------------------------------------------------------------------
  # High CPU
  # Upstream: DarlingAlertSettings.CpuThresholdPercent / AlertEngine.CheckCpuAsync
  # Fires when the latest collected CPU sample (SQL process + other, TotalServer mode) >= threshold.
  # Source: DarlingAlertSettings.cs, AlertEngine.cs CheckCpuAsync
  # Source table: collect.v_cpu_utilization_stats (no total_cpu_utilization column - summed
  # from sqlserver_cpu_utilization + other_process_cpu_utilization)
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - High CPU"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-cpu-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "High CPU - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT cu.sqlserver_cpu_utilization + COALESCE(cu.other_process_cpu_utilization, 0) AS cpu_pct
                FROM collect.v_cpu_utilization_stats AS cu
                WHERE cu.server_id = {{ _sid }}
                ORDER BY cu.collection_time DESC
                LIMIT 1
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ perfmon_alert_cpu_pct | float }}
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            CPU utilization on {{ item.inventory_hostname }} exceeded {{ perfmon_alert_cpu_pct }}%.

  # -----------------------------------------------------------------------
  # Blocking Detected
  # Upstream: DarlingAlertSettings.BlockingCountThreshold / AlertEngine.CheckBlockingAsync
  # Fires on a rolling 1-hour COUNT of captured blocking events (XE preferred, DMV-snapshot
  # fallback when XE captured none) - Grafana has no live-DMV wait-duration signal here.
  # Source: DarlingAlertReadAdapter.cs BlockedProcessReportsSql / DmvBlockingSnapshotsSql
  # Source tables: collect.v_blocked_process_reports, collect.v_dmv_blocking_snapshots
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - Blocking Detected"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-blocking-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "Blocking Detected - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                WITH xe AS (
                    SELECT COUNT(*) AS xe_count
                    FROM collect.v_blocked_process_reports
                    WHERE server_id = {{ _sid }}
                      AND collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '1 hour'
                ),
                dmv AS (
                    SELECT COUNT(*) AS dmv_count
                    FROM collect.v_dmv_blocking_snapshots
                    WHERE server_id = {{ _sid }}
                      AND collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '1 hour'
                )
                SELECT CASE WHEN xe.xe_count > 0 THEN xe.xe_count ELSE dmv.dmv_count END AS blocking_count
                FROM xe, dmv
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ perfmon_alert_blocking_count | float }}
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            {{ item.inventory_hostname }} captured {{ perfmon_alert_blocking_count }} or more
            blocking event(s) in the last hour.

  # -----------------------------------------------------------------------
  # Deadlocks Detected
  # Upstream: DarlingAlertSettings.DeadlockCountThreshold / AlertEngine.CheckDeadlocksAsync
  # Fires when total deadlock events in the last 5 minutes >= threshold. No rollup table
  # exists - deadlocks is an event table, one row per deadlock, so a plain COUNT(*) does not
  # double-count.
  # Source: DarlingAlertReadAdapter.cs DeadlocksSql
  # Source table: collect.v_deadlocks
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - Deadlocks Detected"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-deadlocks-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "Deadlocks Detected - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT COUNT(*) AS deadlock_count
                FROM collect.v_deadlocks
                WHERE server_id = {{ _sid }}
                  AND collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '5 minutes'
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ perfmon_alert_deadlock_count | int }}
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            {{ perfmon_alert_deadlock_count }} or more deadlock(s) detected on {{ item.inventory_hostname }} in the last 5 minutes.

  # -----------------------------------------------------------------------
  # TempDB Space
  # Upstream: DarlingAlertSettings.TempDbSpaceThresholdPercent / AlertEngine.CheckTempDbAsync
  # Fires when used pct of allocated TempDB space >= threshold, from the latest snapshot.
  # Source: DarlingAlertReadAdapter.cs TempDbSpaceSql
  # Source table: collect.v_tempdb_stats
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - TempDB Space"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-tempdb-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "TempDB Space - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT td.total_reserved_mb * 100.0
                       / NULLIF(td.total_reserved_mb + td.unallocated_mb, 0) AS tempdb_pct
                FROM collect.v_tempdb_stats AS td
                WHERE td.server_id = {{ _sid }}
                ORDER BY td.collection_time DESC
                LIMIT 1
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - {{ perfmon_alert_tempdb_pct | float }}
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            TempDB on {{ item.inventory_hostname }} is {{ perfmon_alert_tempdb_pct }}% or more full.

  # -----------------------------------------------------------------------
  # Low Disk Space
  # Upstream: DarlingAlertSettings.LowDiskThresholdPercent / LowDiskThresholdGb /
  # AlertEngine.CheckLowDiskAsync
  # Fires when any volume hosting a database file, at the latest snapshot, is below the
  # free-space floor. Files on the same volume share one row (MAX total / MIN free).
  # Source: DarlingAlertReadAdapter.cs VolumeFreeSpaceSql
  # Source table: collect.v_database_size_stats
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - Low Disk Space"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-disk-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "Low Disk Space - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT COUNT(*) AS disk_alert
                FROM (
                    SELECT MAX(volume_total_mb) AS total_mb, MIN(volume_free_mb) AS free_mb
                    FROM collect.v_database_size_stats
                    WHERE server_id = {{ _sid }}
                      AND collection_time = (
                          SELECT MAX(collection_time) FROM collect.v_database_size_stats
                          WHERE server_id = {{ _sid }}
                      )
                      AND volume_mount_point IS NOT NULL
                      AND volume_total_mb > 0
                    GROUP BY volume_mount_point
                ) v
                WHERE v.free_mb / 1024.0 < {{ perfmon_alert_disk_free_gb | float }}
                   OR v.free_mb * 100.0 / NULLIF(v.total_mb, 0) < {{ perfmon_alert_disk_free_pct | float }}
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 5m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            A volume on {{ item.inventory_hostname }} has less than {{ perfmon_alert_disk_free_pct }}% free
            or less than {{ perfmon_alert_disk_free_gb }} GB free.

  # -----------------------------------------------------------------------
  # Long-Running Query
  # Upstream: DarlingAlertSettings.LongRunningQueryThresholdMinutes /
  # AlertEngine.CheckLongRunningQueryAsync
  # Fires when any query in the latest collected snapshot (under 10 minutes old) has been
  # running >= threshold minutes. All five noise opt-outs applied (all true upstream default).
  # Source: DarlingAlertReadAdapter.cs LongRunningQueriesSqlTemplate + the five *Filter consts
  # Source table: collect.v_query_snapshots
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - Long-Running Query"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-long-query-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "Long-Running Query - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT COUNT(*) AS long_query_count
                FROM collect.v_query_snapshots AS r
                WHERE r.server_id = {{ _sid }}
                  AND r.collection_time = (
                      SELECT MAX(vqs.collection_time) FROM collect.v_query_snapshots AS vqs
                      WHERE vqs.server_id = {{ _sid }}
                  )
                  AND r.collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '10 minutes'
                  AND r.session_id > 50
                  AND r.wait_type NOT LIKE '%SP_SERVER_DIAGNOSTICS%'
                  AND (r.query_text IS NULL OR r.query_text NOT ILIKE '%sp_server_diagnostics%')
                  AND r.wait_type NOT IN ('WAITFOR', 'BROKER_RECEIVE_WAITFOR')
                  AND r.wait_type NOT IN ('BACKUPTHREAD', 'BACKUPIO')
                  AND r.wait_type NOT IN ('XE_LIVE_TARGET_TVF')
                  AND COALESCE(r.is_cdc_capture, FALSE) = FALSE
                  AND r.total_elapsed_time_ms >= {{ (perfmon_alert_query_duration_floor_min * 60000) | int }}
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            A query on {{ item.inventory_hostname }} has been running for
            {{ perfmon_alert_query_duration_floor_min }} or more minutes.

  # -----------------------------------------------------------------------
  # Poison Wait
  # Upstream: DarlingAlertSettings.PoisonWaitThresholdMs / AlertEngine.CheckPoisonWaitAsync
  # Fires when avg ms per wait event for any of the three poison wait types exceeds the
  # threshold. Pure absolute check against the most recent rows in the last 10 minutes - no
  # baseline comparison.
  # Source: DarlingAlertReadAdapter.cs PoisonWaitsSql
  # Source table: collect.v_wait_stats (delta_wait_time_ms / delta_waiting_tasks are the
  # delta_-prefixed columns)
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - Poison Wait"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-poison-wait-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "Poison Wait - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT COUNT(*) AS poison_wait_count
                FROM (
                    SELECT
                        CASE WHEN delta_waiting_tasks > 0
                             THEN delta_wait_time_ms::double precision / delta_waiting_tasks
                             ELSE 0 END AS avg_ms_per_wait
                    FROM collect.v_wait_stats
                    WHERE server_id = {{ _sid }}
                      AND wait_type IN ('THREADPOOL', 'RESOURCE_SEMAPHORE', 'RESOURCE_SEMAPHORE_QUERY_COMPILE')
                      AND delta_waiting_tasks > 0
                      AND collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '10 minutes'
                    ORDER BY collection_time DESC
                    LIMIT 3
                ) t
                WHERE avg_ms_per_wait >= {{ perfmon_alert_poison_wait_floor_ms | float }}
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            A poison wait type on {{ item.inventory_hostname }} has avg wait >= {{ perfmon_alert_poison_wait_floor_ms }}ms per event
            (THREADPOOL, RESOURCE_SEMAPHORE, or RESOURCE_SEMAPHORE_QUERY_COMPILE).

  # -----------------------------------------------------------------------
  # Long-Running Job
  # Upstream: DarlingAlertSettings.LongRunningJobMultiplier / AlertEngine.CheckAnomalousJobsAsync
  # Fires when any currently running SQL Agent job's duration is >= the multiplier x its
  # historical average, from the latest running_jobs snapshot (under 10 minutes old). Unscoped
  # to every job - Darling collects headlessly, so no synthetic collector job exists to scope to.
  # Source: DarlingAlertReadAdapter.cs AnomalousJobsSql
  # Source table: collect.v_running_jobs
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - Long-Running Job"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-long-job-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "Long-Running Job - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 600
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT COUNT(*) AS long_job_count
                FROM collect.v_running_jobs
                WHERE server_id = {{ _sid }}
                  AND collection_time = (
                      SELECT MAX(collection_time) FROM collect.v_running_jobs WHERE server_id = {{ _sid }}
                  )
                  AND collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '10 minutes'
                  AND avg_duration_seconds >= 60
                  AND percent_of_average >= {{ (perfmon_alert_long_running_job_multiplier * 100) | int }}
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            A SQL Agent job on {{ item.inventory_hostname }} has been running
            for {{ perfmon_alert_long_running_job_multiplier }}x or more its average duration.

  # -----------------------------------------------------------------------
  # Failed Job
  # Upstream: DarlingAlertSettings.FailedJobLookbackMinutes / AlertEngine.CheckFailedJobsAsync
  # Fires when any SQL Agent job's outcome row (step_id = 0, run_status = 0 = Failed) was
  # recorded within the lookback window. Unscoped to every job, same as Long-Running Job above.
  # Reads collect.job_history rather than live msdb - FailedJobsQuery is not part of Darling's
  # own collected-store read surface either, so there is no Grafana-reachable live equivalent.
  # Source: FailedJobsQuery.cs (WHERE clause), JobHistoryCollector.cs (collected column shapes)
  # Source table: collect.job_history
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - Failed Job"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-failed-job-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "Failed Job - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT COUNT(*) AS failed_job_count
                FROM collect.job_history
                WHERE server_id = {{ _sid }}
                  AND step_id = 0
                  AND run_status = 0
                  AND run_datetime >= (now() AT TIME ZONE 'UTC')
                      - INTERVAL '{{ perfmon_alert_failed_job_lookback_min | int }} minutes'
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            A SQL Agent job on {{ item.inventory_hostname }} has failed
            within the last {{ perfmon_alert_failed_job_lookback_min }} minutes.

  # -----------------------------------------------------------------------
  # Collection Stopped
  # No direct upstream equivalent - Darling's own version is a live connect-edge alert, state
  # Grafana cannot observe. Fires when collect.collection_log has no row for this server within
  # the staleness window, or none at all - the same freshness signal the Collection Health
  # dashboard's STALE/FAILING banding reads (darling_defs/collection_health.py).
  # Source table: collect.collection_log
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - Collection Stopped"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-collection-stopped-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "Collection Stopped - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 300
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT CASE
                    WHEN MAX(collection_time) IS NULL
                      OR EXTRACT(EPOCH FROM ((now() AT TIME ZONE 'UTC') - MAX(collection_time))) / 60
                         >= {{ perfmon_alert_collection_stale_min | int }}
                    THEN 1 ELSE 0
                END AS collection_stopped
                FROM collect.collection_log
                WHERE server_id = {{ _sid }}
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            Data collection for {{ item.inventory_hostname }} appears to have stopped: no
            collection_log row within the last {{ perfmon_alert_collection_stale_min }} minutes.

  # -----------------------------------------------------------------------
  # AG Failover
  # Upstream: AgAlertPolicy.IsFailover / AgAlertPolicy.FailoverMetric
  # Fires when a replica's role_desc differs from its prior reading. Not deduped across
  # nodes watching the same AG.
  # Source: PerformanceMonitor.Common/AgAlertPolicy.cs
  # Source table: collect.ag_replica_states
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - AG Failover"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-ag-failover-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "AG Failover - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                WITH ranked AS (
                    SELECT
                        role_desc,
                        LAG(role_desc) OVER (
                            PARTITION BY ag_name, replica_server_name ORDER BY collection_time
                        ) AS prev_role_desc,
                        ROW_NUMBER() OVER (
                            PARTITION BY ag_name, replica_server_name ORDER BY collection_time DESC
                        ) AS rn
                    FROM collect.ag_replica_states
                    WHERE server_id = {{ _sid }}
                      AND collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '1 hour'
                )
                SELECT COUNT(*) AS failover_count
                FROM ranked
                WHERE rn = 1
                  AND role_desc IS NOT NULL AND role_desc <> ''
                  AND prev_role_desc IS NOT NULL AND prev_role_desc <> ''
                  AND role_desc <> prev_role_desc
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 0s
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            An Availability Group replica role changed on {{ item.inventory_hostname }} -
            check for a failover in progress.

  # -----------------------------------------------------------------------
  # AG Replica Disconnected
  # Upstream: AgAlertPolicy.DecideConnection / IsDisconnected
  # Fires while the latest connected_state_desc is DISCONNECTED. The resolved notification
  # covers upstream's separate "AG Replica Reconnected" metric.
  # Source: PerformanceMonitor.Common/AgAlertPolicy.cs
  # Source table: collect.ag_replica_states
  # -----------------------------------------------------------------------
  - orgId: 1
    name: "PerfMon (Darling) - AG Replica Disconnected"
    folder: "{{ grafana_darling_folder }}"
    interval: 1m
    rules:
      - uid: "{{ 'darling-ag-disconnected-' | darling_alert_uid(item.inventory_hostname) }}"
        title: "AG Replica Disconnected - {{ item.inventory_hostname }}"
        condition: C
        data:
          - refId: A
            relativeTimeRange:
              from: 3600
              to: 0
            datasourceUid: "{{ perfmon_darling_ds_uid }}"
            model:
              datasource:
                type: grafana-postgresql-datasource
                uid: "{{ perfmon_darling_ds_uid }}"
              format: table
              rawQuery: true
              rawSql: >
                SELECT COUNT(*) AS disconnected_count
                FROM (
                    SELECT DISTINCT ON (ag_name, replica_server_name)
                        connected_state_desc
                    FROM collect.ag_replica_states
                    WHERE server_id = {{ _sid }}
                      AND collection_time >= (now() AT TIME ZONE 'UTC') - INTERVAL '1 hour'
                    ORDER BY ag_name, replica_server_name, collection_time DESC
                ) latest
                WHERE UPPER(latest.connected_state_desc) = 'DISCONNECTED'
              refId: A
          - refId: C
            datasourceUid: "-100"
            model:
              conditions:
                - evaluator:
                    params:
                      - 1
                    type: gte
                  operator:
                    type: and
                  query:
                    params:
                      - A
                  reducer:
                    params: []
                    type: last
                  type: query
              datasource:
                type: __expr__
                uid: "-100"
              expression: A
              refId: C
              type: threshold
        noDataState: OK
        execErrState: Error
        for: 1m
        labels:
          team: perfmon
          instance: "{{ item.inventory_hostname }}"
        annotations:
          summary: >
            An Availability Group replica reported by {{ item.inventory_hostname }} is
            DISCONNECTED from its primary.

  # -----------------------------------------------------------------------
