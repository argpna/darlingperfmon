{
  "postgres": {
    "connectionString": "Host=darling-pg;Port=5432;Username=darling;Password=${DARLING_PG_PASSWORD};Database=darling"
  },
  "servers": [
    {
      "name": "SQL2022",
      "host": "mssql-2022",
      "auth": "sql",
      "username": "sa",
      "password": "${MSSQL_SA_PASSWORD}",
      "trustServerCertificate": true,
      "encryptMode": "Optional",
      "excludedDatabases": []
    },
    {
      "name": "SQL2025",
      "host": "mssql-2025",
      "auth": "sql",
      "username": "sa",
      "password": "${MSSQL_SA_PASSWORD}",
      "trustServerCertificate": true,
      "encryptMode": "Optional",
      "excludedDatabases": []
    }
  ],
  "capturePlans": true,
  "alerts": {
    "enabled": false
  },
  "analysis": {
    "enabled": false
  },
  "mcp": {
    "enabled": false
  },
  "web": {
    "enabled": false
  }
}
